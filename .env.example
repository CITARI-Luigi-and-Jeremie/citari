# Il n'y a PAS de mode démo, et il ne faut pas en réintroduire un.
#
# `GEO_MOCK=1` faisait renvoyer une base simulée par `getDb()`, la fonction dont
# se sert le toolkit pour rédiger les relances. Une variable oubliée suffisait
# donc à préparer des emails pleins de chiffres inventés, prêts à partir à de
# vrais prospects. Le piège a mordu : l'admin a tourné des semaines sur des
# données simulées avec le mot de passe « demo ». Retiré le 06/08/2026.

# Providers LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# Modèles interrogés — VÉRIFIÉS LE 06/08/2026, À NE PAS CHANGER À LA LÉGÈRE.
#
# Le modèle interrogé fait PARTIE de la mesure : une version différente ne
# répond pas pareil, donc le score bouge. S'il change entre le scan initial et
# le contrôle J+90, on annonce au client une progression qu'il n'a pas
# produite. Ces valeurs ne doivent bouger que sur décision explicite, et
# jamais pendant qu'un sprint est en cours.
#
# Deux règles qui découlent de là :
#
#  1. JAMAIS d'alias mouvant. « mistral-large-latest » veut dire « la dernière
#     en date » : l'éditeur peut la remplacer du jour au lendemain. Pire, le
#     code demandait « grok-4 » et xAI servait déjà grok-4.3 sans rien dire.
#     Toujours un nom précis et daté.
#  2. Ces lignes doivent refléter les défauts de `moteurs.server.ts`. Elles
#     annonçaient gpt-4o et gemini-2.0-flash alors que le code utilisait tout
#     autre chose : une documentation fausse est pire que pas de documentation.
#
# Perplexity est le seul cas non figeable : « sonar » est un nom roulant et
# l'éditeur ne publie aucune version datée. Risque subi, assumé, documenté.
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ANALYSE_MODEL=gemini-3.1-flash-lite
PERPLEXITY_MODEL=sonar
XAI_MODEL=grok-4.5
MISTRAL_MODEL=mistral-large-2512

# Infra
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Envoi des emails post-scan (pnpm toolkit envoyer). La clé se crée sur
# resend.com ; le domaine citari.fr doit y être vérifié (SPF + DKIM posés
# chez Hostinger) AVANT le premier envoi, sinon tout part en indésirables.
RESEND_API_KEY=
# Un prénom en expéditeur, pas une marque seule : en B2B de dirigeant à
# dirigeant, « Luigi de Citari » est ouvert, « Citari » est filtré.
RESEND_FROM="Luigi de Citari <contact@citari.fr>"
# Boîte réelle qui reçoit les réponses (Reply-To et lien de désinscription).
CONTACT_EMAIL=contact@citari.fr

# Apps
ADMIN_PASSWORD=
FOUNDER_EMAIL=
CRON_SECRET=
# Signature utilisée dans les emails de relance générés par le toolkit
FOUNDER_SIGNATURE="Luigi Revelli
Citari"
BOOKING_URL=https://cal.com/votre-compte/restitution
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
