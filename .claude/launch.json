{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "citari-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/citari",
        "run",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "citari-admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "admin",
        "dev"
      ],
      "port": 3001
    }
  ]
}
